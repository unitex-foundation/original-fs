{
  "name": "@unitex/original-fs",
  "productName": "UNITEX Original FS",
  "description": "Fake node fs module to make Electron happy",
  "author": {
    "name": "Grigorii Lutkov",
    "email": "grigorii@lutkov.dev"
  },
  "version": "1.0.3",
  "homepage": "https://trulab.ru/unitex/original-fs",
  "repository": {
    "type": "git",
    "url": "git+https://trulab.ru/unitex/original-fs.git"
  },
  "bugs": {
    "url": "https://trulab.ru/unitex/original-fs/-/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "format": "prettier --ignore-unknown --check",
    "format_all": "npm run-script format ./",
    "format_fix": "npm run-script format --write",
    "format_fix_all": "npm run-script format_all --write"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist/",
    "third_party_licenses/",
    "CONTRIBUTORS.md",
    "COPYING.md",
    "COPYRIGHT.md",
    "LICENSE.md",
    "README.md",
    "third_party_licenses.md"
  ],
  "devDependencies": {
    "@types/node": "8.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "v26.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.12.1",
      "onFail": "warn"
    }
  },
  "type": "module",
  "keywords": [
    "unitex",
    "fs",
    "original",
    "electron",
    "fake",
    "renamed",
    "backend"
  ]
}
